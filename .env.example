# Base de donnees
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar_foncier
DATABASE_URL=postgresql+psycopg://radar:radar@db:5432/radar_foncier

# LLM (optionnel au MVP -- non utilise, interface prete pour la V1)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Frontend -> Backend
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://backend:8000

# Securite (voir backend/app/core/security.py et frontend/middleware.ts) --
# laissees vides en local/dev : l'app reste ouverte sans mot de passe. A definir
# obligatoirement en production (Render) avec des valeurs fortes et uniques.
INTERNAL_API_KEY=
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
